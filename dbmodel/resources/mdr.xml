<?xml version="1.0"?>
<!--
to consider: superclass clinicalentity = { study, object}
TODO: check HDcat and use appropriate names
see https://healthdcat-ap.github.io/
e.g.
clinicalentity -> concept

- keep Annotable from core for rdf

terms already fine marked with dcat

-->

<!-- Version 4.2 -->
<classes>
  <class name="Concept" is-interface="true" extends="Annotatable">
    <!-- <attribute name="secondaryIdentifier" type="java.lang.String"/> -->
    <collection name="relationships" referenced-type="Relationship"/>
  </class>

  <class name="DataSource" is-interface="true">
    <collection name="studies" referenced-type="Study" reverse-reference="dataSources" term="http://semanticscience.org/resource/SIO_001277"/>
  </class>

  <class name="DataSet" is-interface="true">
    <collection name="studies" referenced-type="Study" reverse-reference="dataSets" term="http://semanticscience.org/resource/SIO_001277"/>
    <collection name="studyObjects" referenced-type="StudyObject" reverse-reference="dataSets" term="http://semanticscience.org/resource/SIO_001277"/>
  </class>

  <!-- Controlled vocabulary -->
  <class name="CVTerm" is-interface="true">
      <attribute name="type" type="java.lang.String"/>
      <attribute name="value" type="java.lang.String"/>
      <attribute name="source" type="java.lang.String"/>
  </class>

  <class name="Country" is-interface="true">
    <attribute name="isoAlpha2" type="java.lang.String"/>
    <attribute name="isoAlpha3" type="java.lang.String"/>
    <attribute name="name" type="java.lang.String"/>
    <attribute name="capital" type="java.lang.String"/>
    <attribute name="continent" type="java.lang.String"/>
    <attribute name="tld" type="java.lang.String"/>
    <attribute name="geonameId" type="java.lang.String"/>
    <collection name="studyCountries" referenced-type="StudyCountry" reverse-reference="country"/>
  </class>

  <class name="Study" is-interface="true" extends="Concept">
    <!-- TODO: last updated date? -->
    <attribute name="title" type="java.lang.String"/>
    <attribute name="scientificTitle" type="java.lang.String"/>
    <attribute name="acronym" type="java.lang.String"/>
    <attribute name="titleLang" type="java.lang.String"/> <!-- TODO: populate this -->
    <attribute name="description" type="java.lang.String"/>
    <attribute name="planToShareIPD" type="java.lang.String"/>
    <attribute name="dataSharingStatement" type="java.lang.String"/>
    <attribute name="startDate" type="java.util.Date"/>
    <attribute name="endDate" type="java.util.Date"/>
    <attribute name="type" type="java.lang.String"/>
    <attribute name="status" type="java.lang.String"/> <!-- TODO: harmonise? -->
    <attribute name="genderElig" type="java.lang.String"/>
    <attribute name="plannedEnrolment" type="java.lang.Integer"/>
    <attribute name="actualEnrolment" type="java.lang.Integer"/>
    <attribute name="ageGroup" type="java.lang.String"/>
    <attribute name="minAge" type="java.lang.Float"/>
    <attribute name="minAgeUnit" type="java.lang.String"/>
    <attribute name="maxAge" type="java.lang.Float"/>
    <attribute name="maxAgeUnit" type="java.lang.String"/>
    <attribute name="iec" type="java.lang.String"/>
    <attribute name="interventionsDescription" type="java.lang.String"/> <!-- TODO: see later -->
    <attribute name="primaryOutcome" type="java.lang.String"/>
    <attribute name="secondaryOutcomes" type="java.lang.String"/>
    <attribute name="hasResults" type="java.lang.Boolean"/>
    <!-- One-to-many -->
    <collection name="studyCountries" referenced-type="StudyCountry" reverse-reference="study"/>
    <collection name="studyFeatures" referenced-type="StudyFeature" reverse-reference="study"/>
    <collection name="studyIdentifiers" referenced-type="StudyIdentifier" reverse-reference="study"/>
    <collection name="studySites" referenced-type="StudySite" reverse-reference="study"/>
    <!-- <collection name="relationships" referenced-type="Relationship"/> -->
    <!-- StudyObjects -->
    <collection name="resultsSummaries" referenced-type="RegistryResultsSummary" reverse-reference="study"/>
    <collection name="protocols" referenced-type="Protocol" reverse-reference="study"/>
    <collection name="statisticalAnalysisPlans" referenced-type="StatisticalAnalysisPlan" reverse-reference="study"/>
    <collection name="informedConsentForms" referenced-type="InformedConsentForm" reverse-reference="study"/>
    <collection name="ethicsApprovalNotifications" referenced-type="EthicsApprovalNotification"
               reverse-reference="study"/>
    <collection name="individualParticipantData" referenced-type="IndividualParticipantData" reverse-reference="study"/>
    <!-- Many-to-many -->
    <collection name="biosamples" referenced-type="Biosample" reverse-reference="studies"/>
    <collection name="studyConditions" referenced-type="StudyCondition" reverse-reference="studies"/>
    <collection name="interventions" referenced-type="Intervention" reverse-reference="studies"/>
    <collection name="organisations" referenced-type="Organisation" reverse-reference="studies"/>
    <collection name="people" referenced-type="Person" reverse-reference="studies"/>
    <collection name="dataSets" referenced-type="DataSet" reverse-reference="studies"/>
    <collection name="dataSources" referenced-type="DataSource" reverse-reference="studies"/>
  </class>

  <class name="StudyCondition" is-interface="true">
    <attribute name="term" type="java.lang.String"/>
    <attribute name="meddraCode" type="java.lang.String"/>
    <attribute name="meshCode" type="java.lang.String"/>
    <attribute name="meshTreeNumber" type="java.lang.String"/>
    <collection name="studies" referenced-type="Study" reverse-reference="studyConditions"/>
  </class>

  <class name="StudyCountry" is-interface="true">
    <attribute name="countryName" type="java.lang.String"/>
    <attribute name="status" type="java.lang.String"/>
    <attribute name="plannedEnrolment" type="java.lang.Integer"/>
    <attribute name="compAuthorityDecisionDate" type="java.util.Date"/>
    <attribute name="ethicsCommitteeDecisionDate" type="java.util.Date"/>
    <reference name="study" referenced-type="Study" reverse-reference="studyCountries"/>
    <reference name="country" referenced-type="Country" reverse-reference="studyCountries"/>
    <collection name="studySites" referenced-type="StudySite" reverse-reference="studyCountry"/>
  </class>

  <class name="StudyFeature" is-interface="true">
    <reference name="study" referenced-type="Study" reverse-reference="studyFeatures"/>
    <attribute name="type" type="java.lang.String"/>
    <attribute name="value" type="java.lang.String"/>
  </class>

  <class name="StudyIdentifier" is-interface="true">
    <reference name="study" referenced-type="Study" reverse-reference="studyIdentifiers"/>
    <attribute name="value" type="java.lang.String"/>
    <attribute name="type" type="java.lang.String"/>
    <attribute name="source" type="java.lang.String"/>
    <attribute name="sourceRor" type="java.lang.String"/>
  </class>

  <class name="StudySite" is-interface="true">
    <reference name="study" referenced-type="Study" reverse-reference="studySites"/>
    <attribute name="facility" type="java.lang.String"/> <!-- TODO: change this to reference? remove city if changed to ref? -->
    <attribute name="city" type="java.lang.String"/>
    <reference name="studyCountry" referenced-type="StudyCountry" reverse-reference="studySites"/>
    <attribute name="countryName" type="java.lang.String"/>
    <attribute name="status" type="java.lang.String"/>
    <collection name="contacts" referenced-type="Person" reverse-reference="sites"/>
  </class>

  <class name="Intervention" is-interface="true">
    <attribute name="type" type="java.lang.String"/>
    <attribute name="name" type="java.lang.String"/>
    <attribute name="meshCode" type="java.lang.String"/>
    <attribute name="meshTreeNumber" type="java.lang.String"/>
    <collection name="studies" referenced-type="Study" reverse-reference="interventions"/>
  </class>

  <class name="StudyObject" is-interface="true" extends="Concept">
    <attribute name="doi" type="java.lang.String"/>
    <reference name="managingOrg" referenced-type="Organisation" reverse-reference="objects"/>
    <attribute name="langCode" type="java.lang.String"/> <!-- TODO: populate this -->
    <attribute name="accessType" type="java.lang.String"/>
    <attribute name="accessUrl" type="java.lang.String"/>
    <attribute name="dateCreated" type="java.util.Date"/>
    <attribute name="datePublished" type="java.util.Date"/>
    <attribute name="dateUpdated" type="java.util.Date"/>
    <attribute name="publicationYear" type="java.lang.Integer"/>
    <collection name="dataSets" referenced-type="DataSet" reverse-reference="studyObjects"/>
  </class>

  <class name="RegistryResultsSummary" is-interface="true" extends="StudyObject">
    <!-- title ->? primaryidentifier -->
    <!-- TODO: add details field -->
    <reference name="study" referenced-type="Study" reverse-reference="resultsSummaries"/>
  </class>

  <class name="Protocol" is-interface="true" extends="StudyObject">
    <attribute name="title" type="java.lang.String"/>
    <attribute name="protocolSponsorId" type="java.lang.String"/>
    <reference name="study" referenced-type="Study" reverse-reference="protocols"/>
  </class>

  <class name="StatisticalAnalysisPlan" is-interface="true" extends="StudyObject">
    <!-- access url -> primaryidentifier -->
    <attribute name="title" type="java.lang.String"/>
    <reference name="study" referenced-type="Study" reverse-reference="statisticalAnalysisPlans"/>
  </class>

  <class name="InformedConsentForm" is-interface="true" extends="StudyObject">
    <!-- access url -> primaryidentifier -->
    <attribute name="title" type="java.lang.String"/>
    <reference name="study" referenced-type="Study" reverse-reference="informedConsentForms"/>
  </class>
  
  <class name="EthicsApprovalNotification" is-interface="true" extends="StudyObject">
    <!-- title ->? primaryidentifier -->
    <!-- TODO: could probably rename to ethicsdecisionnotification and add a decision boolean field? -->
    <!-- TODO: add reviews from EUCTR? only at study country level for now -->
    <reference name="study" referenced-type="Study" reverse-reference="ethicsApprovalNotifications"/>
  </class>

  <class name="IndividualParticipantData" is-interface="true" extends="StudyObject">
  <!-- TODO: possibly rename/remove fields and modify to Boolean -->
    <attribute name="restrictCommercial" type="java.lang.String"/>
    <attribute name="restrictGeo" type="java.lang.String"/>
    <attribute name="restrictResearchType" type="java.lang.String"/>
    <attribute name="consentDetails" type="java.lang.String"/>
    <reference name="study" referenced-type="Study" reverse-reference="individualParticipantData"/>
  </class>

  <class name="Biosample" is-interface="true" extends="StudyObject">
    <attribute name="title" type="java.lang.String"/>
    <attribute name="description" type="java.lang.String"/>
    <attribute name="materialTypes" type="java.lang.String"/>
    <!-- TODO: possibly rename/remove fields and modify to Boolean -->
    <attribute name="restrictCommercial" type="java.lang.String"/>
    <attribute name="restrictGeo" type="java.lang.String"/>
    <attribute name="restrictResearchTypeNonGenetic" type="java.lang.String"/>
    <attribute name="restrictResearchTypeGenetic" type="java.lang.String"/>
    <attribute name="geneticUseAllowed" type="java.lang.String"/>
    <attribute name="consentDetails" type="java.lang.String"/>
    <collection name="studies" referenced-type="Study" reverse-reference="biosamples"/>
  </class>

  <class name="Person" is-interface="true">
    <attribute name="contribType" type="java.lang.String"/>
    <attribute name="fullName" type="java.lang.String"/>
    <attribute name="email" type="java.lang.String"/>
    <collection name="studies" referenced-type="Study" reverse-reference="people"/>
    <collection name="affiliations" referenced-type="Organisation" reverse-reference="people"/>
    <collection name="sites" referenced-type="StudySite" reverse-reference="contacts"/>
  </class>

  <class name="Organisation" is-interface="true">
    <attribute name="contribType" type="java.lang.String"/>
    <attribute name="type" type="java.lang.String"/>
    <attribute name="name" type="java.lang.String"/>
    <attribute name="ror" type="java.lang.String"/>
    <collection name="studies" referenced-type="Study" reverse-reference="organisations"/>
    <collection name="objects" referenced-type="StudyObject" reverse-reference="managingOrg"/>
    <collection name="people" referenced-type="Person" reverse-reference="affiliations"/>
  </class>

  <class name="Relationship" is-interface="true">
    <attribute name="type" type="java.lang.String"/>
    <reference name="subject" referenced-type="Concept"/>
    <reference name="relation" referenced-type="Concept"/>
  <!--
    <collection name="studies" referenced-type="Study" reverse-reference="people"/>
    <collection name="objects" referenced-type="StudyObject" reverse-reference="people"/>
  -->
  </class>
</classes>
